{
  "name": "defense-learning-guide",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "pretest": "npm run content",
    "content": "node scripts/build-site.mjs",
    "dev": "npm run content && vite",
    "check": "tsc --noEmit",
    "build": "npm run content && npm run check && vite build",
    "preview": "vite preview",
    "test": "node --test website/tests/*.test.ts",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "format": "prettier --write --ignore-path .gitignore \"website/**/*.{ts,tsx,css,html}\" \"scripts/*.mjs\" package.json tsconfig.json vite.config.ts playwright.config.ts .prettierrc.json",
    "format:check": "prettier --check --ignore-path .gitignore \"website/**/*.{ts,tsx,css,html}\" \"scripts/*.mjs\" package.json tsconfig.json vite.config.ts playwright.config.ts .prettierrc.json"
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "marked": "18.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
